# ════════════════════════════════════════════════════════════════════
#  Eng-Mart — PRODUCTION environment
#  Copy to the host's environment settings. Do NOT commit the real file.
#  Local development keeps using backend/.env (DEBUG=True) — leave it alone.
# ════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────
# A fresh key was generated for you below. If you prefer your own:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The app REFUSES TO START in production with a weak/dev key — that is deliberate.
DJANGO_SECRET_KEY=+16797g3j)ru*espp^!pt*bj$bi=(1=pqi)d%!99j(078v0wrw

# Must be False. Leaving it True exposes tracebacks, settings and SQL to visitors.
DEBUG=False

# Every hostname the site answers on. A request with any other Host is rejected.
ALLOWED_HOSTS=eng-mart.com,www.eng-mart.com

# ─── Database ───────────────────────────────────────────────────────
# Use the TRANSACTION POOLER string (port 6543) for the app.
# Port 5432 (direct) is only for pg_dump/pg_restore — see MIGRATE-DB-REGION.md.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_CONN_MAX_AGE=600

# ─── Cache ──────────────────────────────────────────────────────────
# REQUIRED in production. Without it each Gunicorn worker keeps its own
# in-memory cache, so workers disagree and admin edits appear to "not save"
# until you hit the right worker. Upstash has a free tier with a Mumbai region.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# ─── Frontend / CORS ────────────────────────────────────────────────
# No trailing slash. Only the real site — never leave localhost here.
FRONTEND_URL=https://eng-mart.com
CORS_ORIGINS=https://eng-mart.com,https://www.eng-mart.com

# ─── Email (SendGrid) ───────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=no-reply@eng-mart.com
SALES_NOTIFICATION_EMAIL=info.engmart@gmail.com
REPLY_TO_EMAIL=info.engmart@gmail.com

# ─── HTTPS ──────────────────────────────────────────────────────────
# Leave both unset unless you know you need to change them.
#   SECURE_SSL_REDIRECT defaults to True in production.
#   SECURE_HSTS_SECONDS defaults to 3600 (1 hour).
# Raise HSTS to 31536000 (1 year) ONLY after HTTPS is confirmed working —
# browsers cache it and you cannot undo it quickly.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ─── Dead legacy config ─────────────────────────────────────────────
# CLERK_* was from the original FastAPI+Clerk plan. Authentication is Django
# SimpleJWT. Do not set these — they are read by nothing.
